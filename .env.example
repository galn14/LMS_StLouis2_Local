# Database Configuration
DB_HOST=${DB_HOST}
DB_PORT=${DB_PORT}
DB_NAME=${DB_NAME}
DB_USER=${DB_USER}
DB_PASSWORD=${DB_PASSWORD}

# Database URL for Prisma
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Raw connections: LMS database (read-only helper) and the aux AI database (pgvector)
LMS_POSTGRES_URL=
AUX_POSTGRES_URL=
# "false" for a local Postgres without TLS; unset keeps the NODE_ENV behaviour
POSTGRES_SSL=

# AI provider: "local" = Ollama, "openai" = baseline arm (code default)
AI_PROVIDER=local
# Validated local grading prompt (local-v2). Without it the local model uses the
# admin ai_config prompt, which was tuned for gpt-4o-mini and grades worse locally.
LOCAL_SYSTEM_PROMPT_FILE=prompts/grading-system-prompt-local-v2.txt

# Local (Ollama) knobs. Precedence: env > local_ai_config row > built-in default
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:14b-instruct-q4_K_M
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_EMBED_DIMS=1024
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1536
OLLAMA_KEEP_ALIVE=30m
LOCAL_RAG_TOP_K=6

# OpenAI arm only (the admin Credentials tab takes precedence over this)
OPENAI_API_KEY=